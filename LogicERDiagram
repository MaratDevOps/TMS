@startuml
hide circle
skinparam linetype ortho

entity "Payment Request\n(Запрос на оплату)" as PaymentRequest {

    * ID : UUID
    --
    Company : String
    == Компания ==

    BusinessPartner : String
    == Бизнес-партнер ==

    Invoice : String
    == Счет ==

    Amount : Decimal
    == Сумма ==

    Currency : String
    == Валюта ==

    RequestedPaymentDate : Date
    == Запрашиваемая дата оплаты ==

    PaymentMethod : String
    == Способ оплаты ==

    HouseBank : String <<optional>>
    == Домашний банк (необязательно) ==

    CashFlowCategory : String
    == Категория денежного потока ==

    Priority : String
    == Приоритет ==

    Status : String
    == Статус ==
}

@enduml