@startuml End-to-End Payment Process
title SAP Treasury - End-to-End Payment Process

start

partition "ERP (FI/MM/SD)" {
    :Create Invoice;
    :Generate Payment Request;
}

partition "Treasury & Risk Management" {

    :Import Payment Request;
    :Validate Request;

    if (Validation successful?) then (Yes)
        :Create Payment Request Object;
    else
        :Send Validation Error;
        stop
    endif

    :Approval Workflow;

    if (Approved?) then (Yes)
    else
        :Cancel Request;
        stop
    endif
}

partition "Cash Management" {

    :Calculate Cash Position;

    :Run Liquidity Forecast;

    if (Enough Liquidity?) then (Yes)
    else
        :Payment Block;
        stop
    endif
}

partition "Payment Factory" {

    :Create Payment Proposal;

    :Review Proposal;

    :Generate Payment Order;
}

partition "Bank Communication Management" {

    :Generate ISO20022 XML;

    :Transmit Payment File;
}

partition "External Bank" {

    :Execute Payment;

    :Return Bank Statement;
}

partition "Cash Management" {

    :Import Statement;

    :Automatic Matching;

    :Reconciliation;

    :Update Cash Position;

    :Update Forecast;
}

stop

@enduml