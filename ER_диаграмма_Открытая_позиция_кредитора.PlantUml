@startuml FI_AP_Open_Vendor_Item_ER
title Открытая позиция кредитора FI-AP\nER-диаграмма по контракту payment.demand

hide circle
skinparam linetype ortho

entity "Open Vendor Item (FI-AP)\nОткрытая позиция кредитора" as OpenVendorItem {
  * id : UUID <<PK>>
  --
  * sourceLineItemId : string
  * documentType : string = VENDOR_OPEN_ITEM
  * companyCode : string <<BUKRS>>
  * fiscalYear : string <<GJAHR>>
  * documentNumber : string
  * documentData : date
  * positionNumber : string
  * lineItemID : string
  * sourceLineItemReference : string
  --
  originDocumentId : UUID <<FK → OriginDocument.id, optional>>
  --
  * counterpartyId : string
  * counterpartyRole : string = VENDOR
  * amount : decimal > 0
  * currency : string <<ISO 4217>>
  * dueDate : date
  * paymentPurpose : string
  * paymentMethod : string
  * paymentBlock : boolean
  * status : string
}

entity "originDocument\nДокумент-основание" as OriginDocument {
  * id : UUID <<PK>>
  --
  * companyCode : string <<BUKRS>>
  * documentType : string
  * documentNumber : string
  * documentData : date
}

OriginDocument |o--o{ OpenVendorItem : originDocument

note bottom of OpenVendorItem
  sourceLineItemId совпадает с Kafka key.
  lineItemID — каноническое строковое представление
  номера FI-позиции.
end note

note right of OriginDocument
  Заполняется только если позиция создана
  из внешнего документа, например MIRO.
end note
@enduml
